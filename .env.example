# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (never commit real values).

# Public origin of THIS website (exact scheme + host, no trailing slash).
# Enquiry submissions are only accepted from this origin.
SITE_URL=http://localhost:3001

# Allow search engines to index the site. Keep false until public launch.
INDEXABLE=false

# NCore Fleets backend origin (no /api suffix).
NCORE_API_URL=http://localhost:8000

# Website integration credential from NCore:
# Dashboard → Charter Management → Website enquiries → Website integrations.
# Server-side only. Never prefix with NEXT_PUBLIC_.
NCORE_INTEGRATION_CREDENTIAL=

# Required in production for rate limiting (e.g. Upstash Redis rediss:// URL).
REDIS_URL=

# Google Maps for address search and the route map on the quote form (optional;
# without it the form uses plain address fields). This is a BROWSER key: in
# Google Cloud restrict it to this site's domains (HTTP referrers) and to the
# Maps JavaScript API, Places API (New), Geocoding API and Routes API.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID from Google Cloud → Map Management (optional; DEMO_MAP_ID is used if empty).
GOOGLE_MAPS_MAP_ID=

# Header holding the real client IP, set ONLY if your platform overwrites it.
# On Vercel use: x-real-ip. Leave empty elsewhere unless a trusted proxy sets it.
TRUSTED_CLIENT_IP_HEADER=
